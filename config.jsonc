{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/icon",
    "type": "file",
    "color": {
      "1":"38;2;242;190;78",
      "2":"38;2;237;152;26",
      "3":"white",
      "4":"black",
      "5":"cyan"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "bar": {
      "char": {
        "total": "─"
      },
      "width": 10
    },
    "percent": {
      "type": 3,
      "ndigits": 2
    },
    "key": {
      "width": 16
    },
    "color": "blink_",
    "separator": ""
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "  ",
      "keyWidth": 4,
      "keyColor": "cyan",
      "format": "{#36}{1}@{2}"
    },
    {
      "type": "datetime",
      "key": " ",
      "format": " {#white}󰃮 {1}-{4}-{10} {14}:{18}:{20} ({22})"
    },
    "break",
    {
      "type": "custom",
      "key": "╭─System─────┬────────────────────────────────────────╮",
      "keyColor": "38;2;237;152;26"
    },
    {
      "type": "host",
      "key": "├╴ PC       │",
      "keyColor": "38;2;237;152;26"
    },
    {
      "type": "os",
      "key": "├╴ OS       │",
      "keyColor": "38;2;237;152;26",
      "format": "{#38;2;85;207;202}{3}{#}"
    },
    {
      "type": "wm",
      "key": "├╴ WM       │",
      "keyColor": "38;2;237;152;26",
      "format": "Rectangle 0.93"
    },
    {
      "type": "packages",
      "key": "├╴󰏖 Packages │",
      "keyColor": "38;2;237;152;26"
    },
    {
      "type": "uptime",
      "key": "├╴󰥔 Uptime   │",
      "keyColor": "38;2;237;152;26"
    },
    {
      "type": "custom",
      "key": "╰────────────┴────────────────────────────────────────╯",
      "keyColor": "38;2;237;152;26"
    },
    {
      "type": "custom",
      "key": "╭─Terminal───┬───────────────────────────────────────╮",
      "keyColor": "38;2;242;190;78"
    },
    {
      "type": "shell",
      "key": "├╴ Shell    │",
      "keyColor": "38;2;242;190;78"
    },
    {
      "type": "terminal",
      "key": "├╴ Terminal │",
      "keyColor": "38;2;242;190;78"
    },
    {
      "type": "terminalfont",
      "key": "├╴ Font     │",
      "keyColor": "38;2;242;190;78"
    },
    {
      "type": "terminalsize",
      "key": "├╴󰘖 Size     │",
      "keyColor": "38;2;242;190;78",
      "format": "{1} colums × {2} rows ({3}px × {4}px)"
    },
    {
      "type": "custom",
      "key": "╰────────────┴───────────────────────────────────────╯",
      "keyColor": "38;2;242;190;78"
    },
    {
      "type": "custom",
      "key": "╭─Hardware───┬───────────────────────────────────────────────╮",
      "keyColor": "38;2;173;54;21"
    },
    {
      "type": "display",
      "key": "├╴󰍹 Display  │",
      "keyColor": "38;2;173;54;21",
      "format": "{1}×{2}, {3}Hz [{7}]"
    },
    {
      "type": "cpu",
      "key": "├╴ CPU      │",
      "keyColor": "38;2;173;54;21",
      "format": "{1} [{3} cores]"
    },
    {
      "type": "gpu",
      "key": "├╴󰢮 GPU      │",
      "keyColor": "38;2;173;54;21"
    },
    {
      "type": "memory",
      "key": "├╴ RAM      │",
      "keyColor": "38;2;173;54;21"
    },
    {
      "type": "disk",
      "key": "├╴ Disk     │",
      "keyColor": "38;2;173;54;21",
      "format": "{13} {1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": "├╴ Battery  │",
      "keyColor": "38;2;173;54;21",
      "format": "{10} {4} ({5})"
    },
    {
      "type": "custom",
      "key": "╰────────────┴────────────────────────────────────────────────╯",
      "keyColor": "38;2;173;54;21"
    },
    {
      "type": "colors",
      "key": "╭─Media──────┬───────────────────────────────────────────────────────╮",
      "keyColor": "38;2;91;95;212",
      "symbol": "diamond"
    },
    {
      "type": "sound",
      "key": "├╴ Sound    │",
      "keyColor": "38;2;91;95;212",
      "format": "{#38;2;85;207;202}{3}{#}"
    },
    {
      "type": "sound",
      "key": "├╴󰋋 Volume   │",
      "keyColor": "38;2;91;95;212",
      "format": "{6} "
    },
    
    {
      "type": "media",
      "key": "├╴ Progress │",
      "keyColor": "38;2;91;95;212",
      "format": "{#38;2;85;207;202}{8} {3} {6}"
    },
    {
      "type": "media",
      "key": "├╴󰋋 PLaying  │",
      "keyColor": "38;2;91;95;212",
      "format": "{2}"
    },
    {
      "type": "custom",
      "key": "╰────────────┴───────────────────────────────────────────────────────╯",
      "keyColor": "38;2;91;95;212"
    }
  ]
}
